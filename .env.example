# Required — Todoist personal API token
# Todoist → Settings → Integrations → Developer → API token
TODOIST_API_TOKEN=

# Optional — Microsoft Graph, for placing drafts directly in your Outlook
# Drafts folder. See docs/GRAPH_SETUP.md. Leave blank to disable the feature.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_REFRESH_TOKEN=
